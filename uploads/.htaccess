# Autorise les images, interdit l’exécution de scripts dans les uploads.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .asp .aspx
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<FilesMatch "\.(?i:php|phtml|phar|cgi|pl|py|asp|aspx|shtml|exe|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:jpe?g|png|gif|webp|svg)$">
        Require all granted
    </FilesMatch>
</IfModule>
