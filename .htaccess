DirectoryIndex index.php
Options -Indexes

# Pages d’erreur : gérées via RewriteRule → errors/*.php (chemins relatifs au site).
# Ne pas fixer ErrorDocument en chemin absolu DocumentRoot (casse /bridge vs racine).

# Ne pas exposer secrets, VCS, outillage et dépendances
<IfModule mod_authz_core.c>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
    <FilesMatch "(?i)^(composer\.(json|lock|phar)|package(-lock)?\.json|phpunit\.xml(\.dist)?)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "(?i)^(composer\.(json|lock|phar)|package(-lock)?\.json|phpunit\.xml(\.dist)?)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Bloquer les dossiers sensibles (même si un .htaccess enfant manque)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.git|\.agents|\.cursor|vendor|config|includes|storage|scripts|database|node_modules)(?:/|$) - [F,L]
</IfModule>

RewriteEngine On

# En production, force le domaine canonique HTTPS.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^goo-bridge\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://goo-bridge.com%{REQUEST_URI} [R=301,L]

# Mode maintenance (flag relatif au dossier du site) — PHP applique aussi le 503
RewriteCond storage/maintenance.flag -f
RewriteCond %{REQUEST_URI} !/(admin|errors|login\.php|logout\.php|maintenance\.php|install\.php) [NC]
RewriteCond %{REQUEST_URI} !\.(css|js|webp|png|jpg|jpeg|gif|svg|ico|woff2?)$ [NC]
RewriteRule ^ maintenance.php [L]

# Routage 404 pour URLs inexistantes dans ce projet (pages d'erreur propres)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/errors/ [NC]
RewriteRule . errors/404.php [L]

# ─────────────────────────────────────────────────────────────
# PERFORMANCE : compression Gzip / Brotli
# ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE\s(7|8|9) !no-gzip !gzip-only-text/html
    Header append Vary User-Agent env=!dont-vary
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ─────────────────────────────────────────────────────────────
# PERFORMANCE : cache navigateur (cache long pour les assets immuables)
# ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType text/javascript               "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon      "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/font-woff2        "access plus 1 year"
</IfModule>

# Fallback cache via mod_headers (toujours dispo sous XAMPP)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|ico|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # En-têtes de sécurité utiles (pas de coût perf)
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set X-XSS-Protection "0"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Charset par défaut + types MIME pour les fonts/webp
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ETag basé sur la taille+date (plus stable, évite invalidations inutiles)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag MTime Size
