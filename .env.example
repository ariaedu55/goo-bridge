# Copiez vers .env à la racine du projet et renseignez les valeurs.
# Le fichier .env n’est pas versionné (voir .gitignore).
# Les variables déjà définies par l’hébergeur ne sont pas écrasées.

# true = envoi activé si identifiants SMTP présents ; false = désactivé même avec mot de passe
# Si absent : activé automatiquement quand SMTP_USERNAME et SMTP_PASSWORD sont tous deux renseignés
# MAIL_ENABLED=true

SMTP_HOST=goo-bridge.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=contact@goo-bridge.com
SMTP_PASSWORD=

MAIL_FROM_EMAIL=contact@goo-bridge.com
MAIL_FROM_NAME=Goo-Bridge — formulaire
SMTP_HOSTNAME=goo-bridge.com
MAIL_TO_EMAIL=contact@goo-bridge.com
MAIL_TO_NAME=Goo-Bridge Contact
